# SM-A346B (Europe)
on early-fs && property:ro.boot.em.model=SM-A346B && property:ro.boot.bootloader=A346BXXU9DYF4
    # TEEgris
    mount none /vendor/tee_eea /vendor/tee bind

# SM-A346E (Asia)
on early-fs && property:ro.boot.em.model=SM-A346E && property:ro.boot.bootloader=A346EXXU9DYF4
    # TEEgris
    mount none /vendor/tee_sea /vendor/tee bind

# SM-A346M (South America)
on early-fs && property:ro.boot.em.model=SM-A346M && property:ro.boot.bootloader=A346MUBU9DYF4
    # TEEgris
    mount none /vendor/tee_latam /vendor/tee bind

# SM-A346N (South Korea)
on early-fs && property:ro.boot.em.model=SM-A346N && property:ro.boot.bootloader=A346NKSU9DYF4
    # TEEgris
    mount none /vendor/tee_kor /vendor/tee bind

# SM-A3460
on early-fs && property:ro.boot.em.model=SM-A3460 && property:ro.boot.bootloader=A3460ZHU9DYF4
    # TEEgris
    mount none /vendor/tee_chn /vendor/tee bind
